.DS_Store

# Claude — never track secrets or machine-local settings, even if symlinked later
claude/settings.local.json
claude/**/*.local.json
claude/.credentials.json
claude/**/credentials*
claude/**/*.key
claude/**/*.pem
claude/**/*.token

# Codex — never track secrets or machine-local overrides
codex/**/*.local.toml
codex/**/*.local.json
codex/**/credentials*
codex/**/*.key
codex/**/*.pem
codex/**/*.token
